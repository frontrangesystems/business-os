{
  "name": "personal-email-os",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/index.ts --worker",
    "dev:ui": "vite --config vite.ui.config.ts",
    "dev:all": "node scripts/dev-up.mjs",
    "build": "tsc -p tsconfig.json && pnpm build:ui",
    "build:ui": "vite build --config vite.ui.config.ts",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/index.js --worker",
    "migrate": "tsx src/migrate.ts",
    "seed:dev": "tsx src/seed-dev.ts"
  },
  "dependencies": {
    "@frontrangesystems/business-os-agent-inbox-categorize": "workspace:^",
    "@frontrangesystems/business-os-agent-inbox-cleanup": "workspace:^",
    "@frontrangesystems/business-os-agent-inbox-surface": "workspace:^",
    "@frontrangesystems/business-os-agent-sdk": "workspace:^",
    "@frontrangesystems/business-os-connectors-all": "workspace:^",
    "@frontrangesystems/business-os-connector-sdk": "workspace:^",
    "@frontrangesystems/business-os-core": "workspace:^",
    "@frontrangesystems/business-os-db": "workspace:^",
    "@frontrangesystems/business-os-module-sdk": "workspace:^",
    "@frontrangesystems/business-os-runtime": "workspace:^",
    "@frontrangesystems/business-os-ui": "workspace:^",
    "@anthropic-ai/sdk": "0.40.1",
    "@aws-sdk/client-s3": "3.899.0",
    "@aws-sdk/lib-storage": "3.899.0",
    "@aws-sdk/s3-request-presigner": "3.899.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "pino": "^9.3.0",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
