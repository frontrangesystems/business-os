{
  "name": "@frontrangesystems/business-os-module-document-parser",
  "version": "0.0.1",
  "description": "Document Parser — upload plan sets/specs, extract a structured takeoff (pay-items with quantity) via the shared extraction engine, search page text, export CSV. The pilot product; single-tenant, no bid-workflow.",
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/lib-storage": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@frontrangesystems/business-os-core": "workspace:^",
    "@frontrangesystems/business-os-extraction-engine": "workspace:^",
    "@frontrangesystems/business-os-module-sdk": "workspace:^",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.4",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "fastify": "^4.28.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@frontrangesystems/business-os-db": "workspace:^",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "fastify": "^4.28.0",
    "react": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontrangesystems/business-os.git",
    "directory": "modules/document-parser"
  }
}
